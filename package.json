{
    "name": "@sandgarden/affiro",
    "version": "0.1.0",
    "description": "Embed Affiro's keystroke-signature verification in any web page, no browser extension required",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/affiro.esm.js",
    "module": "./dist/affiro.esm.js",
    "unpkg": "./dist/affiro.min.js",
    "jsdelivr": "./dist/affiro.min.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandgardenhq/affiro-js.git"
    },
    "bugs": {
        "url": "https://github.com/sandgardenhq/affiro-js/issues"
    },
    "homepage": "https://github.com/sandgardenhq/affiro-js#readme",
    "exports": {
        ".": {
            "import": "./dist/affiro.esm.js"
        }
    },
    "files": [
        "dist/affiro.esm.js",
        "dist/affiro.min.js",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "npx tsc src/*.ts && esbuild src/index.js --bundle --format=esm --outfile=dist/affiro.esm.js && esbuild src/index.js --bundle --format=iife --global-name=Affiro --minify --outfile=dist/affiro.min.js",
        "test": "node --test"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    }
}
